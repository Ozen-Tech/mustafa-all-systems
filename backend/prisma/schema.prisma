// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PROMOTER
  SUPERVISOR
  INDUSTRY_OWNER
  ADMIN
}

enum PhotoType {
  FACADE_CHECKIN
  FACADE_CHECKOUT
  OTHER
}

enum IndustryMissReason {
  STORE_CLOSED
  NO_STOCK
  NO_AUTHORIZATION
  NO_MATERIAL
  PROMOTER_ERROR
  OTHER
}

enum StockImportType {
  STOCK
  SALES
  BOTH
}

enum StockImportStatus {
  PROCESSING
  DONE
  FAILED
}

enum StockLocationType {
  LOJA
  CD
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  phone     String?
  role      UserRole
  state     String?  // UF: "SP", "RJ", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  visitsAsPromoter      Visit[]
  photoQuotas           PhotoQuota[]
  routeAssignments      RouteAssignment[]
  industryAssignments   IndustryAssignment[]
  photoIndustries       PhotoIndustry[]
  industryMisses        IndustryMiss[]
  informationDistributions InformationDistribution[]
  whatsappReports       WhatsAppReport[]
  supervisorRegions     SupervisorRegion[]
  promoterSupervisors   PromoterSupervisor[] @relation("PromoterSupervisors")
  supervisorPromoters   PromoterSupervisor[] @relation("SupervisorPromoters")
  supervisedRoutes      RouteAssignment[]    @relation("SupervisedRoutes")
  redoGrantsAsPromoter  PromoterStoreRedoGrant[] @relation("RedoGrantPromoter")
  redoGrantsGranted     PromoterStoreRedoGrant[] @relation("RedoGrantGrantedBy")
  stockImports          StockImport[]
  industryOwnerAssignment IndustryOwnerAssignment?

  @@index([state])
}

model PromoterStoreRedoGrant {
  id          String    @id @default(uuid())
  promoterId  String
  storeId     String
  grantedById String
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  promoter  User  @relation("RedoGrantPromoter", fields: [promoterId], references: [id], onDelete: Cascade)
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  grantedBy User  @relation("RedoGrantGrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)

  @@index([promoterId, storeId])
  @@index([usedAt])
}

model Store {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  filialCode String? @unique // Código da filial nos relatórios do Mateus (ex: "506")
  address   String
  state     String?
  latitude  Float    @default(0)
  longitude Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([code])
  @@index([filialCode])

  // Relations
  visits                Visit[]
  priceResearch         PriceResearch[]
  routeAssignments      RouteAssignment[]
  industryAssignments   IndustryAssignment[]
  photoIndustries       PhotoIndustry[]
  industryMisses        IndustryMiss[]
  informationDistributions InformationDistribution[]
  storeIndustries       StoreIndustry[]
  promoterStoreRedoGrants PromoterStoreRedoGrant[]
  storeStockItems       StoreStockItem[]
  salesRecords          SalesRecord[]
}

model Visit {
  id               String    @id @default(uuid())
  promoterId       String
  storeId          String
  checkInAt        DateTime
  checkOutAt       DateTime?
  checkInLatitude  Float
  checkInLongitude Float
  checkOutLatitude Float?
  checkOutLongitude Float?
  checkInPhotoUrl  String
  checkOutPhotoUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  promoter       User          @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  photos         Photo[]
  priceResearch  PriceResearch[]
  locations      Location[]
  photoIndustries PhotoIndustry[]
  industryMisses IndustryMiss[]

  @@index([promoterId])
  @@index([storeId])
  @@index([checkInAt])
}

model IndustryMiss {
  id         String   @id @default(uuid())
  visitId    String
  promoterId String
  storeId    String
  industryId String
  reason     IndustryMissReason
  note       String?
  createdAt  DateTime @default(now())

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  promoter User     @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  industry Industry  @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([visitId, industryId])
  @@index([promoterId, createdAt])
  @@index([storeId, createdAt])
  @@index([industryId, createdAt])
  @@index([visitId])
}

model Photo {
  id                String    @id @default(uuid())
  visitId           String
  url               String
  type              PhotoType
  latitude          Float?
  longitude         Float?
  industryId        String?   // Opcional, para rastreamento direto
  selectedIndustryId String?  // Indústria selecionada manualmente pelo promotor
  createdAt         DateTime  @default(now())

  // Relations
  visit         Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  photoIndustries PhotoIndustry[]

  @@index([visitId])
  @@index([type])
  @@index([industryId])
  @@index([selectedIndustryId])
}

model PriceResearch {
  id        String   @id @default(uuid())
  visitId   String
  storeId   String
  productName String
  price     Float
  competitorPrices Json // Array of {competitorName: string, price: number}
  createdAt DateTime @default(now())

  // Relations
  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id])

  @@index([visitId])
  @@index([storeId])
}

model Location {
  id        String   @id @default(uuid())
  visitId   String
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  // Relations
  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([timestamp])
}

model PhotoQuota {
  id            String   @id @default(uuid())
  promoterId    String   @unique
  expectedPhotos Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  promoter User @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([promoterId])
}

model ExportJob {
  id         String   @id @default(uuid())
  userId     String
  status     String   @default("pending") // pending, processing, completed, failed
  progress   Int      @default(0)
  downloadUrl String?
  format     String   // pptx, pdf, excel, html
  filters    Json     // {startDate, endDate, promoterIds, storeIds}
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model RouteAssignment {
  id            String   @id @default(uuid())
  promoterId    String
  storeId       String
  supervisorId  String?
  order         Int      @default(0) // Ordem de visita sugerida
  expectedHours Float?   // Horas esperadas por semana/mês
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  promoter   User  @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supervisor User? @relation("SupervisedRoutes", fields: [supervisorId], references: [id], onDelete: SetNull)

  @@unique([promoterId, storeId])
  @@index([promoterId])
  @@index([storeId])
  @@index([supervisorId])
  @@index([isActive])
}

model Industry {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique // Código único da indústria
  abbreviation  String?  // ex: ROS, DOB, SAL
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  products            Product[]
  photoIndustries     PhotoIndustry[]
  industryMisses      IndustryMiss[]
  industryAssignments IndustryAssignment[]
  informationDistributions InformationDistribution[]
  whatsappReports     WhatsAppReport[]
  storeIndustries     StoreIndustry[]
  industryOwnerAssignments IndustryOwnerAssignment[]

  @@index([code])
  @@index([isActive])
}

model IndustryOwnerAssignment {
  id         String   @id @default(uuid())
  userId     String   @unique
  industryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@index([industryId])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  industryId  String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([industryId, code])
  @@index([industryId])
}

model IndustryAssignment {
  id         String   @id @default(uuid())
  promoterId String
  industryId String
  storeId    String?  // Opcional, se específico por loja
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  promoter User     @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  store    Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([promoterId, industryId, storeId])
  @@index([promoterId])
  @@index([industryId])
  @@index([storeId])
  @@index([isActive])
}

model PhotoIndustry {
  id             String    @id @default(uuid())
  photoId        String
  industryId     String
  promoterId     String
  storeId        String
  visitId        String
  qualityScore   Float?    // Score de qualidade (0-100)
  qualityAnalysis Json?    // JSON com análise detalhada
  hasRupture     Boolean   @default(false)
  analyzedAt     DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  photo              Photo                @relation(fields: [photoId], references: [id], onDelete: Cascade)
  industry            Industry             @relation(fields: [industryId], references: [id], onDelete: Cascade)
  promoter            User                 @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  visit               Visit                @relation(fields: [visitId], references: [id], onDelete: Cascade)
  photoQualityAnalysis PhotoQualityAnalysis?

  @@unique([photoId, industryId])
  @@index([photoId])
  @@index([industryId])
  @@index([promoterId])
  @@index([storeId])
  @@index([visitId])
  @@index([hasRupture])
  @@index([createdAt])
}

model PhotoQualityAnalysis {
  id              String    @id @default(uuid())
  photoIndustryId String    @unique
  overallScore    Float     // Score geral (0-100)
  technicalScore  Float?    // Score técnico
  contentScore    Float?    // Score de conteúdo
  complianceScore Float?    // Score de conformidade
  ruptureDetected Boolean   @default(false)
  analysisDetails Json      // Detalhes da análise em JSON
  analyzedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  // Relations
  photoIndustry PhotoIndustry @relation(fields: [photoIndustryId], references: [id], onDelete: Cascade)

  @@index([overallScore])
  @@index([ruptureDetected])
  @@index([analyzedAt])
}

model InformationDistribution {
  id            String   @id @default(uuid())
  title         String
  content       String   // Texto ou JSON
  industryId    String?
  storeId       String?
  promoterId    String?
  type          String   // estoque, produto, geral
  sourceData    Json?    // Dados do Excel em JSON
  geminiSummary String?  // Resumo gerado pelo Gemini
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  industry Industry? @relation(fields: [industryId], references: [id], onDelete: Cascade)
  store    Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  promoter User?     @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([industryId])
  @@index([storeId])
  @@index([promoterId])
  @@index([type])
  @@index([isActive])
}

model WhatsAppReport {
  id            String   @id @default(uuid())
  recipientPhone String
  recipientName  String
  reportType     String   // promoter, industry, general
  promoterId     String?
  industryId     String?
  dateRange      Json     // {startDate, endDate}
  pdfUrl         String?
  status         String   @default("pending") // pending, sent, failed
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  // Relations
  promoter User?     @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  industry Industry?  @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@index([promoterId])
  @@index([industryId])
  @@index([status])
  @@index([createdAt])
}

model StoreIndustry {
  id         String   @id @default(uuid())
  storeId    String
  industryId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([storeId, industryId])
  @@index([storeId])
  @@index([industryId])
  @@index([isActive])
}

model SupervisorRegion {
  id           String @id @default(uuid())
  supervisorId String
  state        String

  supervisor User @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([supervisorId, state])
  @@index([supervisorId])
  @@index([state])
}

model PromoterSupervisor {
  id           String @id @default(uuid())
  promoterId   String
  supervisorId String

  promoter   User @relation("PromoterSupervisors", fields: [promoterId], references: [id], onDelete: Cascade)
  supervisor User @relation("SupervisorPromoters", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([promoterId, supervisorId])
  @@index([promoterId])
  @@index([supervisorId])
}

// Log de importações dos relatórios semanais do Mateus.
model StockImport {
  id            String            @id @default(uuid())
  fileName      String
  weekLabel     String?
  type          StockImportType   @default(STOCK)
  status        StockImportStatus @default(PROCESSING)
  stockRowCount Int               @default(0)
  salesRowCount Int               @default(0)
  industries    String[]          @default([])
  meta          Json?
  errorMessage  String?
  uploadedById  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  stockItems   StoreStockItem[]
  salesRecords SalesRecord[]

  @@index([status])
  @@index([createdAt])
}

// Estoque por produto/filial (LOJA ou CD), snapshot mais recente por indústria.
model StoreStockItem {
  id           String             @id @default(uuid())
  importId     String
  industryName String
  supplierName String?
  filialCode   String
  filialName   String
  filialRaw    String
  storeId      String?
  state        String?
  locationType StockLocationType?
  productCode  String
  productName  String
  qty          Float              @default(0)
  valueRs      Float?
  idade        Float?
  dde          Float?
  status       String?
  lowTurn      Boolean            @default(false)
  capturedAt   DateTime           @default(now())

  import StockImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  store  Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([industryName])
  @@index([filialCode])
  @@index([storeId])
  @@index([productCode])
  @@index([locationType])
  @@index([importId])
  @@index([storeId, industryName])
}

// Vendas por indústria + filial + produto + mês (período atual vs anterior do relatório).
// Importante: NÃO somar todos os meses — a visão padrão é o mês mais recente com dados.
model SalesRecord {
  id            String   @id @default(uuid())
  importId      String
  industryName  String
  filialCode    String
  filialName    String
  storeId       String?
  state         String?
  bandeira      String?
  month         String?
  productCode   String?
  productName   String?
  category      String?
  qtyCurrent    Float    @default(0)
  qtyPrevious   Float    @default(0)
  qtyTrend      Float    @default(0)
  valueCurrent  Float    @default(0)
  valuePrevious Float    @default(0)
  valueTrend    Float    @default(0)
  productCount  Int      @default(0)
  capturedAt    DateTime @default(now())

  import StockImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  store  Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([industryName])
  @@index([filialCode])
  @@index([storeId])
  @@index([importId])
  @@index([month])
  @@index([state])
  @@index([productCode])
  @@index([industryName, month])
}

